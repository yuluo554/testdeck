include LICENSE
include README.md
include pyproject.toml
include MANIFEST.in
include AGENTS.md
include data/README.md
# 测试引用面：tests 里有测试直接读仓库工作流与演示 GIF，缺失会让附件树 pytest 红（v0.1.0 附件 471/5 的根因）
include .github/workflows/ci.yml
recursive-include docs *.md *.gif
recursive-include src/testdeck/rules *.json
recursive-include plan *.md
recursive-include tools *.py
recursive-include tests *.py
# 基准与数据面：让 sdist 自足（干净环境里能重跑对账与真值复算）
recursive-include bench *.py *.md *.xml *.json *.js *.go *.mod
recursive-include data *.py *.json *.md
# fixture 的 node_modules / 运行残留不进 sdist（体积 + 机器相关）
prune bench/fixtures/playwright/node_modules
prune bench/fixtures/playwright/test-results
